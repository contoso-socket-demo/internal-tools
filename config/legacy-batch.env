# Legacy batch runner settings. Superseded by Vault, kept for the 2024
# reconciliation replay job.
#
# All values here are deliberately NON-FUNCTIONAL placeholders.
#
# AKIAIOSFODNN7EXAMPLE is AWS's own public documentation example key. It is
# detected as an UNVERIFIED secret, which is why the workflow sets
# trufflehog_show_unverified: true. At the default of false, trufflehog finds
# it and then suppresses it, and the demo shows zero secrets.
#
# A Slack incoming-webhook URL was originally here too and had to be removed:
# GitHub push protection blocks that provider pattern on ALL public repos,
# above the repo-level setting, and it cannot be disabled via the API.
BATCH_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Generic high-entropy service credential. No provider prefix, so GitHub does
# not provider-match it, while trufflehog's generic detectors can.
CONTOSO_BATCH_API_TOKEN=7f3a9c2e8b1d4f6a0c5e9b2d8f1a4c7e3b6d9f2a5c8e1b4d
LEGACY_LEDGER_PASSWORD=contoso-ledger-batch-2024
